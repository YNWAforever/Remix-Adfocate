<body>
  <div>
    <div
      class="mx-auto max-w-lg space-y-4 p-4 lg:max-w-5xl"
    >
      <h1
        class="font-display text-2xl font-bold"
      >
        限時任務
      </h1>
      <div
        class="scrollbar-none flex gap-2 overflow-x-auto pb-1"
      >
        <button
          aria-pressed="true"
          class="filter-pill shrink-0 filter-pill-active"
          type="button"
        >
          全部
        </button>
        <button
          aria-pressed="false"
          class="filter-pill shrink-0 "
          type="button"
        >
          社交
        </button>
        <button
          aria-pressed="false"
          class="filter-pill shrink-0 "
          type="button"
        >
          美容
        </button>
        <button
          aria-pressed="false"
          class="filter-pill shrink-0 "
          type="button"
        >
          餐飲
        </button>
        <button
          aria-pressed="false"
          class="filter-pill shrink-0 "
          type="button"
        >
          生活
        </button>
      </div>
      <h2
        class="sr-only"
      >
        所有任務
      </h2>
      <div
        class="grid gap-2 lg:grid-cols-2"
      >
        <a
          href="/mission/pet"
        >
          <article
            class="pastel-card flex gap-3 rounded-[var(--radius)] border-2 border-[var(--color-ink)] bg-white p-3"
          >
            <div
              class="h-20 w-20 shrink-0 overflow-hidden rounded-xl border-2 border-[var(--color-ink)] bg-[var(--color-muted,#E4E4E4)]"
            />
            <div
              class="min-w-0 flex-1"
