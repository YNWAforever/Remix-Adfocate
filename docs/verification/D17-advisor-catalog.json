            "definition": "CREATE OR REPLACE FUNCTION public.match_kb_chunks(query_embedding vector, match_count integer DEFAULT 5, filter_locale text DEFAULT 'zh-HK'::text, filter_workspace text DEFAULT NULL::text)\n RETURNS TABLE(chunk_id uuid, document_id uuid, title text, source_type text, source_ref text, content text, similarity double precision)\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select c.id, c.document_id, d.title, d.source_type, d.source_ref, c.content,\r\n         1 - (c.embedding <=> query_embedding) as similarity\r\n  from public.kb_chunks c\r\n  join public.kb_documents d on d.id = c.document_id\r\n  where d.locale = filter_locale\r\n    and (d.workspace is null or d.workspace = filter_workspace)\r\n  order by c.embedding <=> query_embedding\r\n  limit match_count;\r\n$function$\n",
