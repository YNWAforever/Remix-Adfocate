VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# server (Hono / Vercel functions)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# The single workspace slug this deploy serves (client + creator self-signup). Default "demo".
VITE_DEFAULT_WORKSPACE=
# Workspaces that creator self-signup (POST /api/me/bootstrap) may join, comma-separated slugs.
# Leave blank unless one deploy serves several brands — blank means VITE_DEFAULT_WORKSPACE only.
BOOTSTRAP_WORKSPACE_SLUGS=
# Login-method flags. Exactly the string "true" enables; unset/anything else hides the method.
# Both default OFF because the provider must be live first, otherwise the button is a dead end —
# see docs/deployment-config-runbook.md items 2 (Google) and 3 (WhatsApp). Email+password and the
# email magic-link are always shown and need no flag.
VITE_ENABLE_GOOGLE=
VITE_ENABLE_WHATSAPP=
# Optional creator support handoff. Leave both blank to hide the support link.
# WhatsApp uses wa.me with an opaque reason code + submission id only.
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
# Optional — enables AI-polished Mission Matcher rationale via the Vercel AI Gateway.
# The matcher works fully without it (templated rationale fallback). Create a key at
# https://vercel.com/<org>/<project>/ai-gateway/api-keys
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=deepseek/deepseek-v4-flash
# Embeddings model for the AI assistant knowledge base (OpenAI-compatible on the gateway)
AI_GATEWAY_EMBED_MODEL="openai/text-embedding-3-small"

# Stage 4A–4C: local mock providers only. All default OFF; production rejects mock mode.
INTEGRATIONS_ENABLED=false
INTEGRATIONS_MODE=
INSTAGRAM_CONNECTIONS_ENABLED=false
DRIVE_CONNECTIONS_ENABLED=false

# Optional D0 MCP skills for the studio chat. Dark by default; see docs/superpowers/specs/2026-11-09-mcp-d0-design.md
STUDIO_MCP_ENABLED=false
# JSON array of allowlisted read-only MCP servers (https, or localhost http for the fixture).
# Phase 2: make the workspace registry (see docs/operations/mcp-registry.sql) authoritative with consent gating.
STUDIO_MCP_REGISTRY=false
STUDIO_MCP_SERVERS=

# Shared secret for the in-app read-only MCP pilot endpoint (server-side only).
MCP_PILOT_TOKEN=

# Optional A2.2 provider OAuth skills (dark unless STUDIO_MCP_OAUTH=true).
STUDIO_MCP_OAUTH=false
# Base64 32-byte AES key used to encrypt provider tokens at rest.
MCP_OAUTH_ENCRYPTION_KEY=
# JSON object: provider -> { authorizationUrl, tokenUrl, redirectUri, clientId, clientSecret, scopes[] }
MCP_OAUTH_PROVIDERS=

# A3.2: allow the studio assistant to record confirm-first brief proposals (never writes).
STUDIO_ASSISTANT_PROPOSALS=false

# A3.2 confirmed-write execution (both required; dark by default).
STUDIO_ASSISTANT_PROPOSAL_EXECUTION=false
PROPOSAL_SIGNING_KEY=
